{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "850px",
      "wideSize": "1380px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#172033"
        },
        {
          "slug": "pink",
          "name": "Pulse Pink",
          "color": "#d81b60"
        },
        {
          "slug": "purple",
          "name": "Electric Purple",
          "color": "#6c5ce7"
        },
        {
          "slug": "green",
          "name": "Fresh Green",
          "color": "#00c2a8"
        },
        {
          "slug": "yellow",
          "name": "Sunny Yellow",
          "color": "#ffb703"
        },
        {
          "slug": "cloud",
          "name": "Cloud",
          "color": "#f4f6fb"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "dropCap": false
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "vw",
        "%"
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "400",
          "lineHeight": "1.1"
        }
      },
      "link": {
        "color": {
          "text": "#6c5ce7"
        }
      }
    }
  }
}
